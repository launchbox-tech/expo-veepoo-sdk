{
  "enabledPlugins": {
    "github@callstack-agent-skills": true
  },
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit 2>&1)",
      "Bash(npx jest *)",
      "Bash(npx expo-module *)",
      "Bash(jar tf *)",
      "Bash(unzip -p *)",
      "Bash(javap *)"
    ]
  },
  "hooks": {
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/react-doctor.sh\""
          }
        ]
      }
    ]
  }
}
